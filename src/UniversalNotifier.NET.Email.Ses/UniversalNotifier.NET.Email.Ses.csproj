<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>UniversalNotifier.NET.Email.Ses</Title>
    <Description>Amazon SES (v2) email provider for UniversalNotifier.NET. Plain REST integration with built-in request signing and no AWS SDK dependency, one individual message per recipient, attachments and inline images.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalNotifier.NET\UniversalNotifier.NET.csproj" />
    <Compile Include="..\Shared\ProviderHttp.cs" Link="Shared\ProviderHttp.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UniversalNotifier.NET.Tests" />
  </ItemGroup>

</Project>
