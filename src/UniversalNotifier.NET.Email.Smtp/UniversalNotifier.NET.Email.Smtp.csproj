<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>UniversalNotifier.NET.Email.Smtp</Title>
    <Description>SMTP email provider for UniversalNotifier.NET, built on MailKit. TLS by default, per-recipient bulk delivery and classified SMTP errors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalNotifier.NET\UniversalNotifier.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UniversalNotifier.NET.Tests" />
  </ItemGroup>

</Project>
